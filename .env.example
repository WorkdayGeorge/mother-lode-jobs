# Copy to .env for local development. In production put secrets in Secret Manager.

SITE_NAME=Mother Lode Jobs
PUBLIC_BASE_URL=http://127.0.0.1:8000
ENVIRONMENT=development          # set to "production" on Cloud Run
DATABASE_URL=sqlite:///./jobs.db # production: postgresql+psycopg://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
SESSION_SECRET=change-me-to-a-long-random-string

# Sign-ups: approval (an admin approves each person), open, or closed
SIGNUP_MODE=approval
# These addresses become admins automatically once they sign up and confirm their email
ADMIN_EMAILS=you@example.com

# Email (without these, emails are printed to the log instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Mother Lode Jobs <jobs@example.com>

# Optional: detailed AI fit reviews
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_SCORES_PER_USER_PER_DAY=25

# Optional sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
